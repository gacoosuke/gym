{
  "name": "@workspace/souvenirs-physiques",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && concurrently --kill-others --names pages,vite \"pnpm run dev:pages\" \"pnpm run dev:vite\"",
    "dev:pages": "wrangler pages dev dist/public --ip 127.0.0.1 --port 8788",
    "dev:vite": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:release": "BASE_PATH=/ pnpm run build",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:local": "wrangler d1 migrations apply souvenirs-physiques --local",
    "db:remote": "wrangler d1 migrations apply souvenirs-physiques --remote",
    "deploy:cloudflare": "pnpm run build:release && wrangler pages deploy dist/public --project-name souvenirs-physiques",
    "setup:pins": "node scripts/setup-pins.mjs",
    "android:add": "cap add android",
    "android:sync": "pnpm run build:release && cap sync android",
    "android:apk": "pnpm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
